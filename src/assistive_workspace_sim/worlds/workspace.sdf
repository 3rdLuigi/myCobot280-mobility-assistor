<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="assistive_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="red_target_block">
      <pose>0.28 0.05 0.811 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
          <material>
            <ambient>1.0 0.0 0.0 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="blue_sorting_bin">
      <pose>0.15 0.25 0.8 0 0 0</pose>
      <static>true</static> <link name="bin_base">
        <pose>0 0 0.005 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.10 0.10 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.01</size></box></geometry>
          <material><ambient>0.0 0.3 0.8 1.0</ambient><diffuse>0.0 0.3 0.8 1.0</diffuse></material>
        </visual>
      </link>

      <link name="wall_front">
        <pose>0.045 0 0.03 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.01 0.10 0.06</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.01 0.10 0.06</size></box></geometry>
          <material><ambient>0.0 0.3 0.8 1.0</ambient><diffuse>0.0 0.3 0.8 1.0</diffuse></material>
        </visual>
      </link>

      <link name="wall_back">
        <pose>-0.045 0 0.03 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.01 0.10 0.06</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.01 0.10 0.06</size></box></geometry>
          <material><ambient>0.0 0.3 0.8 1.0</ambient><diffuse>0.0 0.3 0.8 1.0</diffuse></material>
        </visual>
      </link>

      <link name="wall_left">
        <pose>0 0.045 0.03 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.08 0.01 0.06</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.01 0.06</size></box></geometry>
          <material><ambient>0.0 0.3 0.8 1.0</ambient><diffuse>0.0 0.3 0.8 1.0</diffuse></material>
        </visual>
      </link>

      <link name="wall_right">
        <pose>0 -0.045 0.03 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.08 0.01 0.06</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.01 0.06</size></box></geometry>
          <material><ambient>0.0 0.3 0.8 1.0</ambient><diffuse>0.0 0.3 0.8 1.0</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>